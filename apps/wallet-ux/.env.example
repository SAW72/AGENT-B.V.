# Optional. Defaults to the public Base Sepolia endpoint.
# The URL must answer eth_chainId with 84532. Any other chain, including
# Ethereum mainnet (1) and Base mainnet (8453), is refused.
# Cloudflare Pages: set VITE_* at build time. Vite inlines them.
# Do not put PRIVATE_KEY, RELAYER_PRIVATE_KEY, SPENCER_RUN_AUTH, LIVE_SUBMIT,
# or ADMIN_SECRET here.
# VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional public URL of the Base Sepolia claim relayer. When unset, escrow
# submits stay wallet-direct. When set, the relayer button turns on only after
# GET /health reports the service is up and not paused. The connected wallet
# signs an EIP-712 claim intent. This app does not send a shared secret.
# Example:
# VITE_CLAIM_RELAYER_URL=https://bot-verifier-claim-relayer.onrender.com
# CORS_ORIGINS on that service must include https://agent-bv.pages.dev.
# https://agent-a-wallet-ux.pages.dev stays on that allowlist until a live refund passes on the new site.
